<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <Color x:Key="Accent">#C9A24A</Color>
    <Color x:Key="AccentTint">#1C1707</Color>

    <Color x:Key="Background">#000000</Color>
    <Color x:Key="Surface">#131313</Color>
    <Color x:Key="SurfaceAlt">#1C1C1C</Color>

    <Color x:Key="TextPrimary">#FFFFFF</Color>
    <Color x:Key="TextSecondary">#9A9A9A</Color>
    <Color x:Key="TextMuted">#5C5C5C</Color>

    <Color x:Key="Border">#2A2A2A</Color>
    <Color x:Key="Success">#4ADE80</Color>
    <Color x:Key="Warning">#FBBF24</Color>
    <Color x:Key="Danger">#E5484D</Color>
</ResourceDictionary>
