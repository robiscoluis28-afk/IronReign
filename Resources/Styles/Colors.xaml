<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <Color x:Key="Primary">#C1121F</Color>
    <Color x:Key="PrimaryDark">#8B0E18</Color>
    <Color x:Key="Accent">#FCA311</Color>

    <Color x:Key="Background">#0F1115</Color>
    <Color x:Key="Surface">#171A21</Color>
    <Color x:Key="SurfaceAlt">#1F2430</Color>

    <Color x:Key="TextPrimary">#F5F7FA</Color>
    <Color x:Key="TextSecondary">#B8C1CC</Color>
    <Color x:Key="TextMuted">#7D8590</Color>

    <Color x:Key="Border">#2E3440</Color>
    <Color x:Key="Success">#2EC27E</Color>
    <Color x:Key="Warning">#F4B400</Color>
    <Color x:Key="Danger">#EF4444</Color>
</ResourceDictionary>