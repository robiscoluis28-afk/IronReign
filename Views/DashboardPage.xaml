<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="IronReign.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewmodels="clr-namespace:IronReign.ViewModels"
    xmlns:controls="clr-namespace:IronReign.Controls"
    x:DataType="viewmodels:DashboardViewModel"
    Title="Inicio"
    BackgroundColor="{StaticResource Background}">

    <ScrollView>
        <VerticalStackLayout Padding="20,8,20,28" Spacing="14">

            <Image
                Source="ironreign_wordmark.png"
                Aspect="AspectFit"
                HeightRequest="34"
                HorizontalOptions="Start" />

            <VerticalStackLayout Spacing="2">
                <Label
                    Text="{Binding WelcomeText}"
                    FontSize="24"
                    FontAttributes="Bold"
                    TextColor="{StaticResource TextPrimary}" />

                <Label
                    Text="{Binding ActiveUserText}"
                    FontSize="13"
                    TextColor="{StaticResource TextSecondary}" />
            </VerticalStackLayout>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                <Border Grid.Column="0" Style="{StaticResource BlockCardStyle}" Padding="14">
                    <VerticalStackLayout Spacing="4">
                        <Label
                            Text="{Binding WeeklyTimeText}"
                            FontSize="22"
                            FontAttributes="Bold"
                            TextColor="{StaticResource TextPrimary}" />
                        <Label
                            Text="esta semana"
                            FontSize="12"
                            TextColor="{StaticResource TextSecondary}" />
                    </VerticalStackLayout>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource BlockCardStyle}" Padding="14">
                    <VerticalStackLayout Spacing="4">
                        <Label
                            Text="{Binding MonthlyWorkoutsText}"
                            FontSize="22"
                            FontAttributes="Bold"
                            TextColor="{StaticResource TextPrimary}" />
                        <Label
                            Text="entrenos este mes"
                            FontSize="12"
                            TextColor="{StaticResource TextSecondary}" />
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <Border Style="{StaticResource BlockCardStyle}">
                <VerticalStackLayout Spacing="14">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
                        <Grid Grid.Column="0" WidthRequest="64" HeightRequest="64">
                            <controls:RingProgressView
                                Progress="{Binding WeeklyGoalProgress}"
                                ProgressColor="{StaticResource Accent}"
                                TrackColor="{StaticResource Border}"
                                WidthRequest="64"
                                HeightRequest="64" />
                        </Grid>

                        <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                            <Label
                                Text="Objetivo semanal"
                                FontSize="14"
                                FontAttributes="Bold"
                                TextColor="{StaticResource TextPrimary}" />
                            <Label
                                Text="{Binding WeeklyGoalText}"
                                FontSize="13"
                                TextColor="{StaticResource TextSecondary}" />
                        </VerticalStackLayout>
                    </Grid>

                    <BoxView HeightRequest="1" Color="{StaticResource Border}" />

                    <Label
                        Text="{Binding SummaryCaptionText}"
                        FontSize="13"
                        TextColor="{StaticResource TextSecondary}" />
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource SubtleCardStyle}">
                <VerticalStackLayout Spacing="10">
                    <Label
                    Text="Siguiente paso"
                    FontSize="14"
                    TextColor="{StaticResource Accent}"
                    FontAttributes="Bold" />

                    <Label
                    Text="Empieza tu próximo entreno o crea una rutina para tener una base lista."
                    FontSize="14"
                    TextColor="{StaticResource TextSecondary}" />

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <Button
                        Grid.Column="0"
                        Text="Ir a Entreno"
                        Command="{Binding GoToWorkoutCommand}" />

                        <Button
                        Grid.Column="1"
                        Text="Ver rutinas"
                        Command="{Binding GoToRoutinesCommand}"
                        Style="{StaticResource SecondaryButtonStyle}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
