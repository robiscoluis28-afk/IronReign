<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="IronReign.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewmodels="clr-namespace:IronReign.ViewModels"
    xmlns:controls="clr-namespace:IronReign.Controls"
    x:DataType="viewmodels:DashboardViewModel"
    Title="Inicio"
    BackgroundColor="{StaticResource Background}">

    <ScrollView>
        <VerticalStackLayout Spacing="0" Padding="0,0,0,32">

            <!-- Cabecera visual: logo grande atenuado de fondo + saludo encima -->
            <Grid HeightRequest="190">
                <Image
                    Source="ironreign_icon.png"
                    Aspect="AspectFit"
                    Opacity="0.14"
                    HeightRequest="340"
                    HorizontalOptions="End"
                    VerticalOptions="Center"
                    TranslationX="70" />

                <VerticalStackLayout Padding="20,0" VerticalOptions="End" Margin="0,0,0,20">
                    <Image
                        Source="ironreign_wordmark.png"
                        Aspect="AspectFit"
                        HeightRequest="24"
                        HorizontalOptions="Start"
                        Margin="0,0,0,14" />
                    <Label
                        Text="{Binding WelcomeText}"
                        FontSize="26"
                        FontAttributes="Bold"
                        TextColor="{StaticResource TextPrimary}" />
                </VerticalStackLayout>
            </Grid>

            <BoxView HeightRequest="1" Color="{StaticResource Border}" />

            <!-- Hoy toca -->
            <VerticalStackLayout Padding="20,20,20,20" Spacing="10">
                <Label
                    Text="HOY TOCA"
                    Style="{StaticResource SectionLabelStyle}" />

                <VerticalStackLayout IsVisible="{Binding HasTodayRoutine}" Spacing="14">
                    <VerticalStackLayout Spacing="2">
                        <Label
                            Text="{Binding TodayRoutineName}"
                            FontSize="28"
                            FontAttributes="Bold"
                            TextColor="{StaticResource TextPrimary}" />
                        <Label
                            Text="{Binding TodayExerciseCountText}"
                            FontSize="14"
                            TextColor="{StaticResource TextSecondary}" />
                    </VerticalStackLayout>

                    <Button
                        Text="EMPEZAR"
                        Command="{Binding GoToWorkoutCommand}"
                        HeightRequest="58" />
                </VerticalStackLayout>

                <VerticalStackLayout IsVisible="{Binding HasTodayRoutine, Converter={StaticResource InvertedBoolConverter}}" Spacing="14">
                    <VerticalStackLayout Spacing="2">
                        <Label
                            Text="Día de descanso"
                            FontSize="28"
                            FontAttributes="Bold"
                            TextColor="{StaticResource TextPrimary}" />
                        <Label
                            Text="No tienes ninguna rutina asignada a hoy."
                            FontSize="14"
                            TextColor="{StaticResource TextSecondary}" />
                    </VerticalStackLayout>
                    <Button
                        Text="Asignar rutina"
                        Command="{Binding GoToRoutinesCommand}"
                        Style="{StaticResource SecondaryButtonStyle}"
                        HeightRequest="52" />
                </VerticalStackLayout>
            </VerticalStackLayout>

            <BoxView HeightRequest="1" Color="{StaticResource Border}" />

            <!-- Racha -->
            <VerticalStackLayout Padding="20,20,20,20" Spacing="12">
                <Grid ColumnDefinitions="*,Auto">
                    <Label
                        Grid.Column="0"
                        Text="RACHA"
                        Style="{StaticResource SectionLabelStyle}"
                        VerticalOptions="Center" />
                    <Label
                        Grid.Column="1"
                        Text="{Binding CurrentStreakDays, StringFormat='{0} días'}"
                        FontSize="14"
                        FontAttributes="Bold"
                        TextColor="{StaticResource Accent}" />
                </Grid>

                <CollectionView ItemsSource="{Binding StreakDays}" HeightRequest="88">
                    <CollectionView.ItemsLayout>
                        <GridItemsLayout Orientation="Vertical" Span="7" HorizontalItemSpacing="6" VerticalItemSpacing="6" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="viewmodels:StreakDayItem">
                            <Border
                                HeightRequest="16"
                                WidthRequest="16"
                                BackgroundColor="{Binding Trained, Converter={StaticResource BoolToAccentConverter}}"
                                StrokeThickness="1"
                                Stroke="{StaticResource Border}">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="3" />
                                </Border.StrokeShape>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>

            <BoxView HeightRequest="1" Color="{StaticResource Border}" />

            <!-- Progreso -->
            <VerticalStackLayout Padding="20,20,20,0" Spacing="12">
                <Label
                    Text="PROGRESO · ÚLTIMAS 8 SEMANAS"
                    Style="{StaticResource SectionLabelStyle}" />

                <controls:BarChartView
                    Values="{Binding WeeklyTrend}"
                    BarColor="{StaticResource Accent}"
                    HeightRequest="90" />
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
