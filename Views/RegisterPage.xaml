<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="IronReign.Views.RegisterPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewmodels="clr-namespace:IronReign.ViewModels"
    x:DataType="viewmodels:RegisterViewModel"
    Title="Crear cuenta"
    BackgroundColor="{StaticResource Background}">

    <ScrollView>
        <VerticalStackLayout
            MaximumWidthRequest="480"
            HorizontalOptions="Center"
            Padding="24"
            Spacing="24"
            VerticalOptions="Center">

            <VerticalStackLayout Spacing="12" HorizontalOptions="Center">
                <Image
                    Source="ironreign_wordmark.png"
                    Aspect="AspectFit"
                    WidthRequest="160"
                    HorizontalOptions="Center" />

                <Label
                    Text="Crear cuenta"
                    Style="{StaticResource TitleLabelStyle}"
                    HorizontalTextAlignment="Center" />
            </VerticalStackLayout>

            <Border Style="{StaticResource BlockCardStyle}">
                <VerticalStackLayout Spacing="16">

                    <VerticalStackLayout Spacing="8">
                        <Label Text="Nombre" Style="{StaticResource FieldTitleLabelStyle}" />
                        <Border Style="{StaticResource InputContainerStyle}">
                            <Entry
                                Placeholder="Tu nombre"
                                Text="{Binding DisplayName}" />
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="8">
                        <Label Text="Correo electrónico" Style="{StaticResource FieldTitleLabelStyle}" />
                        <Border Style="{StaticResource InputContainerStyle}">
                            <Entry
                                Placeholder="tucorreo@ejemplo.com"
                                Text="{Binding Email}"
                                Keyboard="Email" />
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="8">
                        <Label Text="Contraseña" Style="{StaticResource FieldTitleLabelStyle}" />
                        <Border Style="{StaticResource InputContainerStyle}">
                            <Entry
                                Placeholder="Elige una contraseña"
                                Text="{Binding Password}"
                                IsPassword="True" />
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="8">
                        <Label Text="Confirmar contraseña" Style="{StaticResource FieldTitleLabelStyle}" />
                        <Border Style="{StaticResource InputContainerStyle}">
                            <Entry
                                Placeholder="Repite la contraseña"
                                Text="{Binding ConfirmPassword}"
                                IsPassword="True" />
                        </Border>
                    </VerticalStackLayout>

                    <Label
                        Text="{Binding ErrorMessage}"
                        TextColor="{StaticResource Danger}"
                        Style="{StaticResource BodyLabelStyle}"
                        IsVisible="{Binding ErrorMessage, Converter={StaticResource StringNotEmptyConverter}}" />

                    <Button
                        Text="Registrarme"
                        Command="{Binding RegisterCommand}"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}"
                        HeightRequest="52" />

                    <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>