<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="IronReign.Views.LoginPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewmodels="clr-namespace:IronReign.ViewModels"
    x:DataType="viewmodels:LoginViewModel"
    Title="Iniciar sesión"
    BackgroundColor="{StaticResource Background}">

    <ScrollView>
        <VerticalStackLayout
            MaximumWidthRequest="480"
            HorizontalOptions="Fill"
            Padding="16"
            Spacing="24"
            VerticalOptions="Center">

            <VerticalStackLayout Spacing="12" HorizontalOptions="Center">
                <Image
                    Source="ironreign_wordmark.png"
                    Aspect="AspectFit"
                    WidthRequest="180"
                    HorizontalOptions="Center" />

                <Label
                    Text="Bienvenido de vuelta"
                    Style="{StaticResource TitleLabelStyle}"
                    HorizontalTextAlignment="Center" />
            </VerticalStackLayout>

            <Border Style="{StaticResource BlockCardStyle}">
                <VerticalStackLayout Spacing="16">

                    <VerticalStackLayout Spacing="8">
                        <Label Text="Correo electrónico" Style="{StaticResource FieldTitleLabelStyle}" />
                        <Border Style="{StaticResource InputContainerStyle}">
                            <Entry
                                Placeholder="tucorreo@ejemplo.com"
                                Text="{Binding Email}"
                                Keyboard="Email" />
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="8">
                        <Label Text="Contraseña" Style="{StaticResource FieldTitleLabelStyle}" />
                        <Border Style="{StaticResource InputContainerStyle}">
                            <Entry
                                Placeholder="Tu contraseña"
                                Text="{Binding Password}"
                                IsPassword="True" />
                        </Border>
                    </VerticalStackLayout>

                    <Label
                        Text="{Binding ErrorMessage}"
                        TextColor="{StaticResource Danger}"
                        Style="{StaticResource BodyLabelStyle}"
                        IsVisible="{Binding ErrorMessage, Converter={StaticResource StringNotEmptyConverter}}" />

                    <Button
                        Text="Entrar"
                        Command="{Binding LoginCommand}"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}"
                        HeightRequest="52" />

                    <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />

                    <Button
                        Text="¿Olvidaste tu contraseña?"
                        Command="{Binding ForgotPasswordCommand}"
                        Style="{StaticResource SecondaryButtonStyle}" />
                </VerticalStackLayout>
            </Border>

            <Button
                Text="Crear una cuenta"
                Command="{Binding GoToRegisterCommand}"
                Style="{StaticResource SecondaryButtonStyle}" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>