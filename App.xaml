<Application
    x:Class="IronReign.App"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:helpers="clr-namespace:IronReign.Helpers">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <helpers:BoolToBackgroundColorConverter x:Key="BoolToBackgroundColorConverter" />
            <helpers:BoolToTextColorConverter x:Key="BoolToTextColorConverter" />
            <helpers:InvertedBoolConverter x:Key="InvertedBoolConverter" />
            <helpers:BoolToOpacityConverter x:Key="BoolToOpacityConverter" />
            <helpers:BoolToAccentConverter x:Key="BoolToAccentConverter" />
            <helpers:StringNotEmptyConverter x:Key="StringNotEmptyConverter" />
            <helpers:IntIsZeroConverter x:Key="IntIsZeroConverter" />
            <helpers:ScheduledDaysToTextConverter x:Key="ScheduledDaysToTextConverter" />
        </ResourceDictionary>
    </Application.Resources>
</Application>